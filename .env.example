# Copy this file to .env and change the values. .env is git-ignored.
# docker-compose.yml reads these, and the backend reads the DB_* and JWT_* ones.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=caddie
MYSQL_USER=caddie
MYSQL_PASSWORD=change-me

# Backend (Spring Boot) - defaults in application.yml match the values above
DB_URL=jdbc:mysql://localhost:3306/caddie
DB_USERNAME=caddie
DB_PASSWORD=change-me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# First admin account, created only if no admin exists yet (must set a new password on first login)
BOOTSTRAP_ADMIN_NAME=Caddie Master
BOOTSTRAP_ADMIN_PHONE=0870000000
BOOTSTRAP_ADMIN_PASSWORD=admin1234

# "production" makes the backend refuse to start while JWT_SECRET, BOOTSTRAP_ADMIN_PASSWORD,
# CHECKIN_REQUIRE_LOCATION or CORS_ALLOWED_ORIGINS are still on their development defaults.
APP_ENVIRONMENT=development
CHECKIN_REQUIRE_LOCATION=false
# Websites allowed to call the API from a browser: the hosted admin board's address(es), comma
# separated, e.g. https://caddies.yourclub.ie. Leave as is for local development.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Push notifications to caddies' phones when they're called (Expo push service)
PUSH_ENABLED=true

# Copy to mobile/.env (git-ignored). Variables starting EXPO_PUBLIC_ are built into the app,
# so never put secrets here.
#
# Where the app finds the backend:
#   Android emulator:            http://10.0.2.2:8080/api   (the emulator's name for your PC)
#   Web browser on your PC:      http://localhost:8080/api
#   Real phone with Expo Go:     http://<your PC's Wi-Fi IP>:8080/api   (run `ipconfig` to find it)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

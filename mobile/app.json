{
  "expo": {
    "name": "Caddie List",
    "slug": "caddie-list",
    "scheme": "caddielist",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caddieapp.mobile"
    },
    "android": {
      "package": "com.caddieapp.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Caddie List checks you're at the club when you tap \"I'm here\". Your location is only read at that moment."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
